{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: build"
    },
    {
      // Starts the scripted model server itself and waits for the port before launching, so
      // the panel cannot come up pointing at nothing. See docs/ui-review.md.
      "name": "Run Extension (mock model)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "build and start mock model",
      "env": { "CODEX_HOME": "${userHome}/.codex-ui-sandbox" }
    }
  ]
}
